# =============================================================================
# config.env.example  —  環境依存の設定テンプレート
#
#   cp config.env.example config.env    してから値を調整する。
#   config.env は .gitignore 済み（コミットされない）。
#
# scripts/*.sh がすべて config.env を読み込む（scripts/lib.sh 経由）。
# 個々の値は実行時に環境変数で上書きも可能:  LIBVIRT_NET=br0 ./scripts/02-...
# =============================================================================

# ---- KVM ホスト / libvirt ---------------------------------------------------
# 接続先。ローカルの system インスタンスなら qemu:///system のまま。
LIBVIRT_URI="${LIBVIRT_URI:-qemu:///system}"

# VM を接続する libvirt ネットワーク。
#   default … インストール時に作られる NAT (192.168.122.0/24)
#   br0 等  … LAN 直結のブリッジ（別物理マシンとクラスタを組むとき）
LIBVIRT_NET="${LIBVIRT_NET:-default}"

# qcow2 ディスクの置き場所（libvirt の default プール）。
POOL_DIR="${POOL_DIR:-/var/lib/libvirt/images}"

# ---- ゲスト OS イメージ ---------------------------------------------------
IMG_URL="${IMG_URL:-https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img}"
# virt-install --os-variant に渡す値（`osinfo-query os` で一覧）。
OS_VARIANT="${OS_VARIANT:-ubuntu24.04}"

# ---- ゲストへのログイン ---------------------------------------------------
# cloud-init で作成するユーザー。Ansible の ansible_user もこれに合わせる。
GUEST_USER="${GUEST_USER:-ubuntu}"
# このユーザーの authorized_keys に登録する公開鍵。無ければ 02 が生成する。
SSH_PUBKEY="${SSH_PUBKEY:-${HOME}/.ssh/id_ed25519.pub}"

# ---- アドレス割り当て規約 -----------------------------------------------
# LIBVIRT_NET=default のときの /24。ブリッジ利用時は LAN に合わせて変更。
NET_PREFIX="${NET_PREFIX:-192.168.122}"
# control-plane の固定 IP（= kubeadm の apiserver-advertise-address）。
CP_IP="${CP_IP:-${NET_PREFIX}.11}"
# worker は ${NET_PREFIX}.$((WORKER_IP_BASE + N))  （N = ノード番号 1,2,3…）
WORKER_IP_BASE="${WORKER_IP_BASE:-20}"

# ---- VM 既定スペック（ロール別）---------------------------------------
CP_VCPUS="${CP_VCPUS:-4}"
CP_RAM_MB="${CP_RAM_MB:-8192}"
CP_DISK_GB="${CP_DISK_GB:-60}"

WORKER_VCPUS="${WORKER_VCPUS:-2}"
WORKER_RAM_MB="${WORKER_RAM_MB:-4096}"
WORKER_DISK_GB="${WORKER_DISK_GB:-40}"

# ---- 命名規約 -----------------------------------------------------------
CP_NAME="${CP_NAME:-k8s-cp-1}"
WORKER_NAME_PREFIX="${WORKER_NAME_PREFIX:-k8s-worker-}"   # + ノード番号
GUEST_DOMAIN="${GUEST_DOMAIN:-k8s.local}"                 # FQDN サフィックス

# ---- ネットワークモード（ADR-0009）------------------------------------
#   nat    … libvirt NAT ネットワーク + DHCP 予約（1 台目の KVM ホスト）
#   bridge … LAN 直結ブリッジ + cloud-init 静的 IP（2 台目以降の KVM ホスト）
NET_MODE="${NET_MODE:-nat}"
# bridge モードのとき: VM に設定するゲートウェイ / DNS / 追加経路。
VM_GATEWAY="${VM_GATEWAY:-192.168.1.1}"
VM_NAMESERVERS="${VM_NAMESERVERS:-192.168.1.1}"
# 既存クラスタ subnet への経路（"CIDR,via" ／ 1 台目の KVM ホスト経由）。
VM_ROUTES="${VM_ROUTES:-192.168.122.0/24,192.168.1.35}"

# ---- ホスト間相互接続（scripts/04-interconnect.sh・1 台目の KVM ホスト）--
# 1 台目 KVM ホストの libvirt subnet と、2 台目以降がいる LAN の CIDR。
# この 2 つの間だけ NAT を無効化し、Flannel のノード間 VXLAN を通す。
LIBVIRT_SUBNET_CIDR="${LIBVIRT_SUBNET_CIDR:-${NET_PREFIX}.0/24}"
LAN_CIDR="${LAN_CIDR:-192.168.1.0/24}"

# ---- Mac から見るとき（mac/ のスクリプト・ドキュメント用の参考値）-----
# KVM ホストの LAN 側アドレスと SSH ユーザー。scripts では未使用。
KVM_HOST_SSH="${KVM_HOST_SSH:-youruser@192.168.0.10}"
